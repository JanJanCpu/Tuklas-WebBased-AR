generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  student
  teacher
}

enum ViewMode {
  ar
  fallback
}

enum ActivityStage {
  Predict
  Observe
  Explain
  Reflection
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  // Wrong-password lockout: see passwordGuard in routes/auth.ts.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  role         Role
  name         String
  createdAt    DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("TeacherStudents", fields: [createdById], references: [id])
  students    User[]  @relation("TeacherStudents")

  sectionId       String?
  enrolledSection Section?  @relation("SectionStudents", fields: [sectionId], references: [id])
  ownedSections   Section[] @relation("TeacherSections")

  records ActivityRecord[]

  receivedFeedback Feedback[] @relation("StudentFeedback")
  givenFeedback    Feedback[] @relation("TeacherFeedback")

  @@index([role])
  @@index([createdById])
  @@index([sectionId])
}

model Section {
  id        String   @id @default(cuid())
  name      String
  teacherId String
  teacher   User     @relation("TeacherSections", fields: [teacherId], references: [id])
  createdAt DateTime @default(now())

  students User[] @relation("SectionStudents")

  @@index([teacherId])
}

model Module {
  id        String   @id
  icon      String
  title     String
  subtitle  String
  quarter   String
  time      String
  task      String
  prediction String
  choices   String[]
  observe   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions ActivityRecord[]
  feedback    Feedback[]
}

model ActivityRecord {
  id        String        @id
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  role      Role
  moduleId  String
  module    Module        @relation(fields: [moduleId], references: [id])
  mode      ViewMode
  stage     ActivityStage
  text      String
  createdAt DateTime
  syncedAt  DateTime      @default(now())

  @@index([moduleId])
  @@index([role])
  @@index([createdAt])
  @@index([userId])
}

// A teacher's grade/comment on one student's work for one module. One row
// per (student, module) - saving again updates it rather than piling up a
// history, matching how a teacher would actually re-grade a redo.
model Feedback {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentFeedback", fields: [studentId], references: [id])
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id])
  teacherId String
  teacher   User     @relation("TeacherFeedback", fields: [teacherId], references: [id])
  score     Int?
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, moduleId])
  @@index([teacherId])
}
